# Copy to web/.env (git-ignored) and fill in. Vite reads this file only at startup: restart `npm run dev` after editing.

# Same Supabase project as the backend. Dashboard ▸ Project Settings ▸ API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. It is designed to be public (the database's Row Level Security protects the data).
# ⚠ NEVER put the service_role / secret key here: it would be shipped to every browser.
VITE_SUPABASE_ANON_KEY=paste-your-anon-key

# Leave empty in development, including LAN testing: the browser uses same-origin /api requests and
# the Vite dev server proxies them to the backend on http://127.0.0.1:4000 from the laptop.
# For a production build served from another origin, set the API's full URL, e.g. https://api.example.com
VITE_API_URL=
