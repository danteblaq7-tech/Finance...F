NODE_ENV=staging
SUPABASE_URL=https://jqmxcnilrwgirsdufzjn.supabase.co
SUPABASE_ANON_KEY=paste-your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=paste-your-staging-service-role-key
# Copy the Session pooler URI from the staging project's Connect panel; URL-encode its password.
DATABASE_URL=postgresql://postgres.jqmxcnilrwgirsdufzjn:<url-encoded-password>@<session-pooler-host>:<port>/postgres
PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
TRUST_PROXY=0
FEE_STATEMENT_MODE=verify
MAX_STATEMENT_MB=5
STUDENT_ID_PATTERN=^[A-Z]{2,6}/\d{3,4}/\d{2}$
# Only set this in the terminal for a deliberate staging integration-test run:
# ALLOW_INTEGRATION_TESTS=staging
# Set staging profile UUIDs before running npm run test:rls:
# RLS_TEST_STUDENT_ID=
# RLS_TEST_STAFF_ID=
# RLS_TEST_LECTURER_ID=
# RLS_TEST_ADMIN_ID=
# RLS_TEST_INACTIVE_ID=
# Optional Gmail SMTP. Use a Google App Password, never your normal Gmail password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# MAIL_FROM="Finesse <your-account@gmail.com>"
