{
  "name": "finesse-backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-test-module-mocks --test",
    "db:schema": "node scripts/db-setup.js schema",
    "db:seed": "node scripts/db-setup.js seed",
    "db:setup": "node scripts/db-setup.js all",
    "db:reset": "node scripts/db-setup.js reset",
    "test:unit": "node --experimental-test-module-mocks --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/api.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "zod": "^3.23.8",
    "unpdf": "^1.0.0"
  }
}
