# ── MySQL (the database you created with finesse_mysql.sql) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finesse

# ── API server ──
PORT=4000
# Where the web app runs (CORS). Comma-separate several origins if needed.
CORS_ORIGIN=http://localhost:5173
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ── Optional: real email delivery. Leave SMTP_HOST empty to only store emails in the sent_emails table. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finesse <noreply@finesse.ac.ke>"
