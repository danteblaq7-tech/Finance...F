# ═══════════════════════════════════════════════════════════════════════════
#  Copy this file to backend/.env and fill it in.   backend/.env is git-ignored: NEVER commit it.
#  In production set these as environment variables on your host instead (Render, Railway, Fly …).
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase project ── dashboard ▸ Project Settings ▸ API ──
SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" (legacy) or "publishable" key. Safe to be public; used to verify passwords.
SUPABASE_ANON_KEY=paste-your-anon-key
# "service_role" (legacy) or "secret" key. ⚠ SERVER-ONLY: full access, bypasses all security rules. Never put it in web/ or mobile/.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key

# ── Database ── dashboard ▸ Connect ▸ "Session pooler" ──
# Use the SESSION POOLER string (host ends in pooler.supabase.com). Replace [YOUR-PASSWORD]; URL-encode special characters (@ → %40).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
# Only for a Postgres on your own machine (no TLS): DATABASE_SSL=false

# ── API server ──
PORT=4000
# Allowed web origins (CORS). Comma-separate exact origins if needed.
# For phone testing with a direct API URL, add http://<laptop-LAN-IP>:5173, e.g. alongside localhost.
CORS_ORIGIN=http://localhost:5173

# ── Production (NODE_ENV=production) ──
# NODE_ENV=production
# The public URL of the web app. Printed exam cards carry a QR code that opens <PUBLIC_WEB_URL>/verify/<code>.
# PUBLIC_WEB_URL=https://finesse.example.ac.ke
# Number of reverse proxies in front of the API (1 on Render/Railway/Fly/Heroku). Default: 1 in production, off otherwise.
# TRUST_PROXY=1

# ── Fee statements uploaded by students ──
# verify (default, safer): a statement showing a balance is denied automatically; one that looks cleared waits for the finance office.
# trust: a cleared statement for the right student/period is approved at once (the card is marked "provisional" until staff verify it).
FEE_STATEMENT_MODE=verify
# Private Supabase Storage bucket for the uploaded files (created automatically on start-up) and the size limit.
STATEMENT_BUCKET=fee-statements
MAX_STATEMENT_MB=5

# ── Optional: real email delivery. Leave SMTP_HOST empty to only store emails in the sent_emails table. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finesse <noreply@finesse.ac.ke>"
