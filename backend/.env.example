# ═══════════════════════════════════════════════════════════════════════════
#  Copy this file to backend/.env and fill it in.   backend/.env is git-ignored: NEVER commit it.
#  Everyone on the team points at the SAME Supabase project, so they all see the same live data.
#  Ask the project owner for these values (send them privately, not in GitHub), or get your own from
#  the Supabase dashboard once the owner has invited you to the project.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase project ── dashboard ▸ Project Settings ▸ API ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" (legacy) or "publishable" key. Safe to be public; used to verify passwords.
SUPABASE_ANON_KEY=sb_publishable_HDSUHbUa_vYrYTiKdiIuLg_NgltUMEn
# "service_role" (legacy) or "secret" key. ⚠ SERVER-ONLY: full access, bypasses all security rules. Never put it in web/ or mobile/.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_0YGMnE8oZ4TjYfeV0HfZ3w_yO8ISiGV

# ── Database ── dashboard ▸ Connect ▸ "Session pooler" ──
# Use the SESSION POOLER string (host ends in pooler.supabase.com). The "Direct connection" host is IPv6-only
# and fails on many networks. Replace [YOUR-PASSWORD] with the database password; URL-encode special characters
# (@ becomes %40, # becomes %23).
DATABASE_URL=postgresql://postgres.jgqatolnzowminewifpt:%40DanteBlaq005@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
host=aws-1-eu-west-1.pooler.supabase.com
port=5432
database=postgres
user=postgres.jgqatolnzowminewifpt
# Only for a Postgres on your own machine (no TLS): DATABASE_SSL=false

# ── API server ──
PORT=4000
# Where the web app runs (CORS). Comma-separate several origins if needed.
CORS_ORIGIN=http://localhost:5173

# ── Optional: real email delivery. Leave SMTP_HOST empty to only store emails in the sent_emails table. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finesse <noreply@finesse.ac.ke>"
