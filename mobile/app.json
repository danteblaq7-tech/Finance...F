{
  "expo": {
    "name": "Finesse",
    "slug": "finesse-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/finesse.png",
    "splash": {
      "image": "./assets/finesse.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4567"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.ac.finesse.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B4567",
        "foregroundImage": "./assets/finesse.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ke.ac.finesse.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Finesse uses the camera to scan student exam cards."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "finesse",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "87609bc6-1be9-445b-a243-4fd06efe926f"
      }
    },
    "owner": "danteblaq"
  }
}
