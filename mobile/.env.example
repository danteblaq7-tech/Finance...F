# Copy to mobile/.env (git-ignored) and fill in. Expo reads this at startup: restart with `npx expo start -c` after editing.
# Same Supabase project as the backend. Dashboard ▸ Project Settings ▸ API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. It is designed to be public (the database's Row Level Security protects the data).
# ⚠ NEVER put the service_role / secret key here: anything EXPO_PUBLIC_ is bundled into the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key

# The Finesse API address. Optional in development: the app finds your computer on the network automatically
# (the same machine that serves the app over Expo) and uses port 4000.
#
# Set this for a release build or a deployed API. It must be https:// for real builds,
# because Android and iOS block plain-http traffic in production apps.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Optional: the address of the Finesse WEB app, used for the link inside the QR code on a student's exam card
# (people who scan it with an ordinary camera land on the public "is this card genuine?" page).
# Without it the QR holds just the card code, which the Finesse scanner reads fine.
# EXPO_PUBLIC_WEB_URL=https://finesse.example.ac.ke
